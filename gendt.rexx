/* $VER: gendt 1.0 (13.05.2026)
 * Generate FinalWriter datatype descriptor (FORM/FDTE)
 * Run: rx gendt.rexx
 */

id="FDTE"

data.1=,
"0000002e0000004c000000200000005a"x||,
"40000000465752310004000000010000"x

data.2=,
"233f2e667700"x

data.3=,
"46696e616c57726974657220446f6375"x||,
"6d656e7400"x

data.4=,
"7465787400"x

data.5=,
"53ff57ff52ff54ff"x

say '/* Generated by gendt.rexx */'
len=4
do i=1 to words(id)-1
  len=len+8+length(data.i)+length(data.i)//2
end
say 'Total IFF size:' len
call open(dt,"FinalWriter.dt",W)
call writech(dt,"FORM"d2c(len,4))
do i=0 to words(id)-1
  call writech(dt,left(word(id,i+1),4))
  if i>0 then call writech(dt,d2c(length(data.i),4)data.i)
  if length(data.i)//2 then call writech(dt,"00"x)
end
call close(dt)
say 'Wrote FinalWriter.dt ('len' bytes)'
address command protect "FinalWriter.dt" e SUB
